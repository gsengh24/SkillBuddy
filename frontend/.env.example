# Frontend configuration. Copy to .env.local to run `npm run dev` outside Docker.
# Validated at runtime by lib/env.ts.

# Base URL the Next.js server uses to call the API (server-side only, never sent to
# browsers). In Docker Compose this is http://api:8000.
API_INTERNAL_URL=http://localhost:8000

# How many reverse proxies sit in front of the web server (Render: 1; Cloudflare in front of
# Render: 2). The visitor's address is read from the right of X-Forwarded-For, so a visitor
# cannot choose their own address and dodge per-IP rate limits. Default 1.
TRUSTED_PROXY_HOPS=1
