# Values for docker-compose.prod.yml. Copy to infra/production.env (git-ignored) and
# fill in every value. In a real deployment these come from a secrets manager, not a
# file on disk.

# Image tag, normally the git SHA. Reported by GET /api/v1/health.
APP_VERSION=
# Registry/namespace prefix for built images, e.g. ghcr.io/your-org/matchmaking
REGISTRY=matchmaking

# --- PostgreSQL (bundled `db` service) ---------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app

# --- Redis (bundled `redis` service) -----------------------------------------------------------
REDIS_PASSWORD=

# --- Backend -------------------------------------------------------------------------------------
# At least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Must match the credentials above when using the bundled services.
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME@db:5432/app
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
# The public origin of the web app, e.g. https://app.example.com
CORS_ALLOW_ORIGINS=
# Public API docs are off by default in production.
API_DOCS_ENABLED=false
LOG_LEVEL=INFO
# IP of the reverse proxy allowed to set X-Forwarded-* headers.
FORWARDED_ALLOW_IPS=127.0.0.1
