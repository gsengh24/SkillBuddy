# Optional overrides for the local Docker Compose stack (docker-compose.yml).
# Copy to .env (git-ignored) only if you need to change something; every value here
# already has a working local default.
#
# Backend application settings are documented in backend/.env.example.

# Host ports (bound to 127.0.0.1 only).
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Local database credentials.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Backend logging.
LOG_LEVEL=INFO
# Set to false for human-readable logs in `make logs`.
LOG_JSON=true

# Local-only signing key (min 32 chars). Leave unset to use the compose default.
# SECRET_KEY=
