# Backend configuration. Copy to backend/.env for running the API outside Docker.
# Docker Compose sets these itself (see docker-compose.yml); you do not need this file
# for `docker compose up`. Never commit a real .env: it is git-ignored.
#
# Every variable is validated at startup (app/core/config.py). Invalid or missing
# required values stop the process with a clear error.

# --- Identity -------------------------------------------------------------------
# Product name shown in the API title and health responses. Rename the product here.
APP_NAME="Skill Buddy"
# Build identifier (git SHA or release tag). Set automatically by the Docker build.
APP_VERSION=dev
# One of: local, test, staging, production. Production enables extra safety checks.
ENVIRONMENT=local
# FastAPI debug mode (tracebacks in responses). Must be false outside local development.
DEBUG=false

# --- HTTP -----------------------------------------------------------------------------
# Serve interactive docs at /docs and the schema at /openapi.json.
API_DOCS_ENABLED=true
# Comma-separated browser origins allowed to call the API. '*' is refused in production.
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Logging ----------------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
# true: one JSON object per line (use everywhere but a local terminal). false: plain text.
LOG_JSON=true

# --- Security ------------------------------------------------------------------------------
# REQUIRED. At least 32 characters. Keys the HMACs for login codes, email hashes and CSRF
# tokens; changing it invalidates outstanding codes. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Authentication (passwordless email codes + server-side sessions; ADR 0006) -------------
# Cookie names for the session (httpOnly) and the CSRF token (readable by the web app).
SESSION_COOKIE_NAME=session
CSRF_COOKIE_NAME=csrf_token
# Send cookies only over HTTPS. Must be true in staging and production; false only for the
# plain-http local stack.
SESSION_COOKIE_SECURE=true
# Sliding expiry: a session lasts this many days after its last use...
SESSION_IDLE_DAYS=30
# ...but never longer than this many days after sign-in.
SESSION_MAX_DAYS=90
# One-time login codes: lifetime in minutes and wrong guesses allowed per code.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Rate limits on the login endpoints (counted in PostgreSQL per window; ADR 0008).
RATE_LIMIT_WINDOW_SECONDS=600
OTP_REQUEST_LIMIT_PER_EMAIL=3
OTP_REQUEST_LIMIT_PER_IP=10
OTP_VERIFY_LIMIT_PER_EMAIL=10
OTP_VERIFY_LIMIT_PER_IP=30
# Days between an account deletion request and the permanent hard delete.
ACCOUNT_DELETION_GRACE_DAYS=30
# Who may sign in (ADR 0011). Comma-separated; empty means no restriction. Matching is exact
# and case-insensitive: thapar.edu admits neither evilthapar.edu nor x.thapar.edu.
# Email codes: addresses on ALLOWED_EMAILS or with a domain on ALLOWED_EMAIL_DOMAINS.
# Google sign-in: domains on ALLOWED_EMAIL_DOMAINS only. BLOCKED_EMAILS is refused by both.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=
BLOCKED_EMAILS=

# --- Matching (ARCHITECTURE.md section 3) ---
# New match requests per user per UTC day, and how many may be open at once.
MATCH_REQUESTS_PER_DAY=10
MAX_OPEN_MATCH_REQUESTS=5
# People suggested per request.
MATCHES_PER_REQUEST=5
# Days a request stays open, and days before it is deleted with its matches.
MATCH_REQUEST_TTL_DAYS=30
MATCH_REQUEST_RETENTION_DAYS=90

# --- Intros and notifications ---
# Intros per user per UTC day, and unanswered at once; days before an intro expires.
INTROS_PER_DAY=10
MAX_PENDING_INTROS=20
INTRO_TTL_DAYS=14
# Days to keep in-app notifications.
NOTIFICATION_RETENTION_DAYS=90
# The web app's public address, used for links in notification emails, e.g.
# https://skillbuddy.vercel.app (no trailing slash). Without it, emails carry no link.
WEB_APP_URL=

# --- Chat (ADR 0012) ---
# Days before a message is deleted (shown to people in the chat).
MESSAGE_RETENTION_DAYS=90
# Messages one person may send per UTC day.
MESSAGES_PER_DAY=300
# Polls for new messages per person per minute.
CHAT_POLLS_PER_MINUTE=40
# Polls for everyone per UTC day (half of Vercel Hobby's monthly requests / 30). Past it,
# chat slows to one poll a minute per person until the next UTC day.
CHAT_POLLS_PER_DAY=16000

# --- Reports and moderation ---
# People one person may block per UTC day.
BLOCKS_PER_DAY=20
# Reports one person may file per UTC day.
REPORTS_PER_DAY=5
# Days to keep a resolved report (and its copy of the messages) after resolving it.
REPORT_RETENTION_DAYS=180
# Where the hourly "new reports waiting" email goes; empty = no email. Never contains
# message text. Set it in the hosting dashboard.
MODERATOR_EMAIL=
# Requests per IP per minute to the /api/v1/admin endpoints.
ADMIN_REQUESTS_PER_MINUTE=30

# --- Google sign-in (ADR 0011; setup steps in docs/deployment-plan.md) ---
# Off, or any value below missing (or ALLOWED_EMAIL_DOMAINS empty): the button is hidden.
GOOGLE_SIGNIN_ENABLED=false
# From Google Cloud > Google Auth Platform > Clients. The secret lives only in the
# hosting dashboard; never commit it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The web app's callback, exactly as listed under "Authorized redirect URIs", e.g.
# https://<your-site>/api/v1/auth/google/callback (https in staging and production).
GOOGLE_OAUTH_REDIRECT_URI=
# Google's endpoints. Override only for the fake provider in tests and the dev stack;
# staging and production refuse other values.
# GOOGLE_OIDC_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_OIDC_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_OIDC_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# GOOGLE_OIDC_ISSUERS=https://accounts.google.com,accounts.google.com
# Seconds to wait for Google's token and key endpoints.
GOOGLE_OIDC_TIMEOUT_SECONDS=10
# "Continue with Google" starts and callbacks per IP per RATE_LIMIT_WINDOW_SECONDS.
GOOGLE_SIGNIN_LIMIT_PER_IP=20

# Version of the terms recorded when a new user accepts them.
TERMS_VERSION=2026-10-01-draft
# Version of the AI-processing consent line on the profile form (ADR 0007, section 5).
# Bump it when the wording changes; users then agree again on their next profile save.
AI_CONSENT_VERSION=2026-10-01
# Profile saves allowed per user per RATE_LIMIT_WINDOW_SECONDS.
PROFILE_UPDATE_LIMIT_PER_USER=20
# Days to keep the auth_events audit log; older rows are pruned daily by a scheduled job.
AUTH_EVENT_RETENTION_DAYS=90

# --- Embeddings (ADR 0007) -------------------------------------------------------------------
# fastembed: BAAI/bge-small-en-v1.5 on CPU in this process (no text leaves the server).
# fake: deterministic vectors without a model, for tests only (refused in staging/production).
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must equal the migrated column size; another size needs a migration and a re-embed.
EMBEDDING_DIMENSIONS=384
# Where the model files are; the production image sets /opt/models (baked in at build time).
# Empty: fastembed's default cache, downloaded on first use (development only).
EMBEDDING_CACHE_DIR=
# ONNX Runtime threads and texts per batch; small values keep memory low on a 512 MB host.
# Batch 2 peaks about 80 MB below batch 8 at the same speed on one thread.
EMBEDDING_THREADS=1
EMBEDDING_BATCH_SIZE=2

# --- AI gateway (ADR 0007) -------------------------------------------------------------------
# Kill switch. false: no request goes to any AI provider; matching uses template explanations.
AI_LLM_ENABLED=true
# Fallback order, comma-separated: groq, cloudflare. A provider without its keys is skipped,
# and when none can answer the caller's template is used.
AI_LLM_PROVIDERS=groq,cloudflare
# Seconds to wait for one provider before trying the next.
AI_LLM_TIMEOUT_SECONDS=20
# Daily caps (UTC day, counted in PostgreSQL): all LLM calls; per user, fresh match
# selections and understanding calls (profile/request parsing).
AI_LLM_DAILY_CALL_CAP=400
AI_USER_DAILY_MATCH_REQUESTS=3
AI_USER_DAILY_UNDERSTAND_CALLS=5
# Groq (primary). SECRET: set it in the hosting dashboard only, never in a committed file.
# Create it at https://console.groq.com/keys. Leave empty to skip Groq.
GROQ_API_KEY=
# Models tried in order, comma-separated; each has its own daily token budget.
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_DAILY_TOKEN_BUDGET=190000
# Cloudflare Workers AI (backup). Account ID (32 hex characters) from the dashboard, and an API
# token with only the "Workers AI" permission. The token is SECRET: hosting dashboard only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-20b
# Kept under the free 10,000 neurons/day; neuron prices per million tokens for the model above.
CLOUDFLARE_DAILY_NEURON_BUDGET=9000
CLOUDFLARE_NEURONS_PER_M_INPUT=18182
CLOUDFLARE_NEURONS_PER_M_OUTPUT=27273

# --- Background jobs (ADR 0008) --------------------------------------------------------------
# Days to keep finished rows in the jobs table; the hourly purge deletes older ones.
JOB_SUCCEEDED_RETENTION_DAYS=7
JOB_DEAD_RETENTION_DAYS=30
# Days to keep email_log (send metadata, no content); at least 2, since the email cap counts
# sends over the trailing 24 hours.
EMAIL_LOG_RETENTION_DAYS=30
# Seconds a claimed job stays reserved; if its process dies, the job runs again after this.
JOBS_LEASE_SECONDS=300
# Retry delay after a failed attempt: base * 2^(attempt - 1), capped at the maximum.
JOBS_RETRY_BASE_SECONDS=10
JOBS_RETRY_MAX_SECONDS=3600
# 0 = never query the database while idle (free hosting, to save Neon compute). A separate
# worker process (dev stack, CI) sets a few seconds so it sees jobs other processes enqueue.
JOBS_IDLE_POLL_SECONDS=0
# Jobs run at the same time: I/O-bound jobs (email, LLM calls) and AI jobs (embeddings).
JOBS_IO_CONCURRENCY=2
JOBS_AI_CONCURRENCY=1
# On shutdown, seconds to let running jobs finish before they are cancelled.
JOBS_SHUTDOWN_GRACE_SECONDS=10
# true on free hosting (no separate worker): the API process runs every job. false: the API
# runs only login-code jobs (their code exists only in its memory) and `python -m
# app.jobs.worker` runs the rest (dev stack, CI).
JOBS_RUN_IN_API=false
# Shared secret for POST /api/v1/admin/jobs/tick (header X-Jobs-Tick-Token), called by the
# scheduler (a Cloudflare Worker cron). At least 32 characters. Unset: the endpoint is off
# (404). Set it in the hosting dashboard and the Worker's secrets, never in the repo.
JOBS_TICK_TOKEN=
# Stand-alone worker only: file touched every 10 s while it runs, checked by the container
# healthcheck. Leave empty elsewhere.
JOBS_HEARTBEAT_FILE=

# --- Email (sent only by background jobs) ----------------------------------------------------
# console: print messages to stdout (local development/tests; refused in staging/production).
# smtp: send through any SMTP server (Mailpit in the dev stack and CI).
# gmail_api: send as a Gmail account over HTTPS (staging and production; ADR 0008).
EMAIL_BACKEND=console
# Sender address; the display name is APP_NAME.
EMAIL_FROM_ADDRESS=no-reply@localhost
SMTP_HOST=localhost
SMTP_PORT=587
# none, starttls or ssl.
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
# Gmail API (EMAIL_BACKEND=gmail_api; staging and production, because Render Free blocks
# SMTP). From a Google Cloud OAuth client ("Desktop app") and a refresh token with the
# https://www.googleapis.com/auth/gmail.send scope; see docs/deployment-plan.md. SECRETS:
# set them in the hosting dashboard only, never in a committed file.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# The Gmail address mail is sent from (the account that granted the refresh token).
GMAIL_SENDER=
# Rolling 24-hour cap (Gmail allows 500 recipients a day) and the part kept for login codes:
# other emails are sent only while more than the reserve is left.
EMAIL_DAILY_CAP=450
EMAIL_RESERVE_FOR_CODES=150

# --- Storage guard (docs/storage-budget.md) ----------------------------------------------------
# The database plan's size limit, in MB (Neon Free: 0.5 GB).
DATABASE_SIZE_LIMIT_MB=500
# Warn at this percentage; pause new sign-ups and non-essential writes at the second.
STORAGE_WARN_PERCENT=70
STORAGE_PAUSE_PERCENT=90
# Optional, 32+ characters. Enables the /api/v1/admin endpoints (storage, reports), sent as
# the X-Admin-Token header. Set it only in the hosting dashboard (Render), never in the repo.
ADMIN_API_TOKEN=

# --- PostgreSQL (with pgvector) -------------------------------------------------------------
# REQUIRED. Must use the psycopg 3 driver scheme: postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
# Connection pool per process.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
# Log every SQL statement. Refused in production.
DB_ECHO=false

# --- Health checks ----------------------------------------------------------------------------
# Per-dependency timeout for GET /api/v1/health/ready.
READINESS_TIMEOUT_SECONDS=2
