# Backend configuration. Copy to backend/.env for running the API outside Docker.
# Docker Compose sets these itself (see docker-compose.yml); you do not need this file
# for `docker compose up`. Never commit a real .env: it is git-ignored.
#
# Every variable is validated at startup (app/core/config.py). Invalid or missing
# required values stop the process with a clear error.

# --- Identity -------------------------------------------------------------------
# Product name shown in the API title and health responses. Rename the product here.
APP_NAME="Skill Buddy"
# Build identifier (git SHA or release tag). Set automatically by the Docker build.
APP_VERSION=dev
# One of: local, test, staging, production. Production enables extra safety checks.
ENVIRONMENT=local
# FastAPI debug mode (tracebacks in responses). Must be false outside local development.
DEBUG=false

# --- HTTP -----------------------------------------------------------------------------
# Serve interactive docs at /docs and the schema at /openapi.json.
API_DOCS_ENABLED=true
# Comma-separated browser origins allowed to call the API. '*' is refused in production.
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Logging ----------------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
# true: one JSON object per line (use everywhere but a local terminal). false: plain text.
LOG_JSON=true

# --- Security ------------------------------------------------------------------------------
# REQUIRED. At least 32 characters. Signs tokens once auth lands. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- PostgreSQL (with pgvector) -------------------------------------------------------------
# REQUIRED. Must use the psycopg 3 driver scheme: postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
# Connection pool per process.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
# Log every SQL statement. Refused in production.
DB_ECHO=false

# --- Redis (job queue, cache, rate limits) ---------------------------------------------------
# REQUIRED.
REDIS_URL=redis://localhost:6379/0

# --- Health checks ----------------------------------------------------------------------------
# Per-dependency timeout for GET /api/v1/health/ready.
READINESS_TIMEOUT_SECONDS=2
